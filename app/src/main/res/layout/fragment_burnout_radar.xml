<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="160dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/bg_wavy_header" android:scaleType="fitXY"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:paddingHorizontal="20dp" android:layout_marginBottom="34sp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair_display_bold"
                        android:text="🔥 BurnoutRadar"
                        android:textColor="@color/text_on_maroon"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Analyzes your 7-day study patterns to detect burnout risk."
                        android:textColor="#CCF5F0EB"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_analyze_burnout"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="Analyze My Study Pattern"
                android:fontFamily="@font/inter_medium" android:textSize="16sp"
                style="@style/UniFlow.Button.Primary"
                android:layout_marginBottom="20dp"/>

            <ProgressBar android:id="@+id/progress_burnout"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <TextView android:id="@+id/tv_burnout_idle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tap the button above to check your burnout risk based on your study activity this week."
                android:fontFamily="@font/inter_regular"
                android:textSize="14sp" android:textColor="@color/text_hint"
                android:gravity="center" android:padding="20dp" android:visibility="visible"/>

            <TextView android:id="@+id/tv_burnout_error"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:textSize="14sp" android:textColor="@color/error_red"
                android:visibility="gone" android:padding="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_burnout_result"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/cream_card"
                app:cardCornerRadius="16dp" app:cardElevation="2dp"
                app:strokeColor="@color/border_light" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">

                    <TextView android:id="@+id/tv_risk_level"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair_display_bold"
                        android:textSize="22sp" android:layout_marginBottom="16dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📊 Analysis" android:fontFamily="@font/inter_medium"
                        android:textSize="15sp" android:textColor="@color/text_primary"
                        android:layout_marginBottom="6dp"/>

                    <TextView android:id="@+id/tv_burnout_summary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp" android:textColor="@color/text_secondary"
                        android:lineSpacingMultiplier="1.4" android:layout_marginBottom="20dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💡 Suggestions" android:fontFamily="@font/inter_medium"
                        android:textSize="15sp" android:textColor="@color/text_primary"
                        android:layout_marginBottom="6dp"/>

                    <TextView android:id="@+id/tv_suggestions"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp" android:textColor="@color/text_secondary"
                        android:lineSpacingMultiplier="1.6" android:layout_marginBottom="16dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/maroon_surface"
                        app:cardCornerRadius="12dp" app:cardElevation="0dp">
                        <TextView android:id="@+id/tv_encouragement"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="15sp" android:textColor="@color/maroon_primary"
                            android:textStyle="italic" android:gravity="center"
                            android:padding="16dp"/>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>