<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_concept_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display_bold"
            android:textSize="24sp"
            android:textColor="@color/maroon_dark"
            android:layout_marginBottom="20dp"/>

        <!-- Simple Explanation -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/cream_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📖 Simple Explanation"
                    android:fontFamily="@font/playfair_display_bold"
                    android:textSize="15sp" android:textColor="@color/maroon_dark"
                    android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tv_simple_explanation"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="14sp" android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.5"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Analogy -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/maroon_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌍 Real Life Analogy"
                    android:fontFamily="@font/playfair_display_bold"
                    android:textSize="15sp" android:textColor="@color/maroon_dark"
                    android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tv_analogy"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="14sp" android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.5"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Key Points -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/cream_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔑 Key Points"
                    android:fontFamily="@font/playfair_display_bold"
                    android:textSize="15sp" android:textColor="@color/maroon_dark"
                    android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tv_key_points"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="14sp" android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.6"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Exam Tip -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/maroon_primary"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <TextView android:id="@+id/tv_exam_tip"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:textSize="14sp" android:textColor="@color/text_on_maroon"
                android:textStyle="italic" android:padding="16dp"
                android:lineSpacingMultiplier="1.4"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>