<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream_bg">

    <!-- Header -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="160dp">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/bg_wavy_header" android:scaleType="fitXY"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center_vertical" android:paddingHorizontal="20dp" android:layout_marginBottom="34dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎙️ Voice Reminder"
                    android:fontFamily="@font/playfair_display_bold"
                    android:textSize="22sp" android:textColor="@color/text_on_maroon"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Speak a reminder, AI sets it for you"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="12sp" android:textColor="#CCF5F0EB"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Content -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">

        <TextView android:id="@+id/tvInstruction"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tap the mic and speak a reminder.\nExample: Remind me to submit assignment tomorrow at 3 PM"
            android:textAlignment="center" android:fontFamily="@font/inter_regular"
            android:textSize="13sp" android:textColor="@color/text_secondary"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnMic"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tap to Speak"
            android:fontFamily="@font/inter_medium"
            android:layout_marginBottom="16dp"
            app:backgroundTint="@color/maroon_primary"
            app:icon="@android:drawable/ic_btn_speak_now"/>

        <TextView android:id="@+id/tvStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:fontFamily="@font/inter_regular"
            android:textSize="15sp" android:textStyle="italic"
            android:textColor="@color/maroon_primary"
            android:layout_marginBottom="8dp"/>

        <ProgressBar android:id="@+id/progressBar"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone" android:layout_marginBottom="8dp"/>

    </LinearLayout>

    <TextView android:id="@+id/tvRemindersHeader"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Your Reminders"
        android:fontFamily="@font/playfair_display_bold"
        android:textSize="18sp" android:textColor="@color/maroon_dark"
        android:visibility="gone"
        android:layout_marginStart="20dp" android:layout_marginBottom="8dp"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingHorizontal="16dp">
        <LinearLayout android:id="@+id/remindersContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

</LinearLayout>