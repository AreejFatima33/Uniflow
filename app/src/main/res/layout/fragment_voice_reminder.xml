<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <!-- Header -->
        <FrameLayout
            android:id="@+id/header_frame"
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_wavy_header"
                android:scaleType="fitXY"
                android:contentDescription="@null"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="44dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="35sp"
                    android:layout_marginBottom="23dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VoiceReminder"
                        android:fontFamily="@font/playfair_display_bold"
                        android:textSize="28sp"
                        android:textColor="@color/text_on_maroon"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Speak a reminder, AI sets it for you"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"
                        android:textColor="#CCF5F0EB"/>
                </LinearLayout>

                <!-- Mic icon badge in header -->
                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_mic_ring_inner"
                    android:gravity="center"
                    android:layout_marginBottom="23dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_mic_voice"
                        android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="29dp"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_back"
                android:background="@drawable/bg_profile_chip"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true"
                android:elevation="6dp"/>

        </FrameLayout>

        <!-- Mic button card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="223dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/cream_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="17dp">

                <!-- Instruction text -->
                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingExtra="3dp"
                    android:text="Tap the mic and speak a reminder.\nExample: Remind me to submit assignment tomorrow at 3 PM"
                    android:textAlignment="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Mic pulse ring + FAB -->
                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp">

                    <View
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_mic_ring_outer" />

                    <View
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_mic_ring_inner" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnMic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contentDescription="Tap to speak"
                        android:src="@drawable/ic_mic_voice"
                        app:backgroundTint="@color/maroon_dark"
                        app:elevation="0dp"
                        app:fabSize="normal"
                        app:tint="@color/text_on_maroon" />
                </FrameLayout>

                <!-- Status label -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/inter_medium"
                    android:text=""
                    android:textColor="@color/maroon_dark"
                    android:textSize="14sp"
                    android:textStyle="italic" />

                <!-- Progress bar -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="160dp"
                    android:layout_height="4dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/maroon_dark"
                    android:progressTint="@color/maroon_dark"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reminders section header -->
        <TextView
            android:id="@+id/tvRemindersHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Reminders"
            android:fontFamily="@font/playfair_display_bold"
            android:textSize="18sp"
            android:textColor="@color/maroon_dark"
            android:visibility="gone"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="8dp"/>

        <!-- Reminders list — no inner ScrollView needed, parent scrolls -->
        <LinearLayout
            android:id="@+id/remindersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"/>

    </LinearLayout>
</ScrollView>