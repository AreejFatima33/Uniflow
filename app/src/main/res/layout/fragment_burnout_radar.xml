<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔥 BurnoutRadar"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyzes your 7-day study patterns to detect burnout risk."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp" />

        <!-- Analyze Button -->
        <Button
            android:id="@+id/btn_analyze_burnout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Analyze My Study Pattern"
            android:textSize="16sp"
            android:backgroundTint="#3F51B5"
            android:layout_marginBottom="20dp" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progress_burnout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Idle message -->
        <TextView
            android:id="@+id/tv_burnout_idle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap the button above to check your burnout risk based on your study activity this week."
            android:textSize="14sp"
            android:textColor="#888888"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="visible" />

        <!-- Error -->
        <TextView
            android:id="@+id/tv_burnout_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#D32F2F"
            android:visibility="gone"
            android:padding="12dp" />

        <!-- Result Card -->
        <LinearLayout
            android:id="@+id/layout_burnout_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@android:color/white"
            android:padding="20dp"
            android:elevation="4dp">

            <!-- Risk Level -->
            <TextView
                android:id="@+id/tv_risk_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Summary -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Analysis"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_burnout_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#444444"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="20dp" />

            <!-- Suggestions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Suggestions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#444444"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="20dp" />

            <!-- Encouragement -->
            <TextView
                android:id="@+id/tv_encouragement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#3F51B5"
                android:textStyle="italic"
                android:gravity="center"
                android:padding="12dp"
                android:background="#E8EAF6" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>