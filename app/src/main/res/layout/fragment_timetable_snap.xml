<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/cream_bg"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Point at your paper timetable and tap Capture"
                android:gravity="center"
                android:fontFamily="@font/inter_regular"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp"/>

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_capture"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Capture Timetable"
                android:fontFamily="@font/inter_medium"
                android:textSize="16sp"
                style="@style/UniFlow.Button.Primary"/>
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_torch"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:src="@android:drawable/btn_star_big_on"
        android:background="@drawable/bg_profile_chip"
        android:contentDescription="Toggle torch"
        android:padding="8dp"
        app:tint="@color/text_on_maroon"/>

</FrameLayout>