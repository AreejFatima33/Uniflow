<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0A0A">

    <!-- Camera preview full screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Viewfinder overlay -->
    <FrameLayout
        android:layout_width="260dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:layout_marginBottom="100dp">

        <!-- Corner brackets -->
        <View android:layout_width="28dp" android:layout_height="3dp"
            android:layout_gravity="top|start"
            android:background="@color/text_on_maroon"/>
        <View android:layout_width="3dp" android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:background="@color/text_on_maroon"/>
        <View android:layout_width="28dp" android:layout_height="3dp"
            android:layout_gravity="top|end"
            android:background="@color/text_on_maroon"/>
        <View android:layout_width="3dp" android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:background="@color/text_on_maroon"/>
        <View android:layout_width="28dp" android:layout_height="3dp"
            android:layout_gravity="bottom|start"
            android:background="@color/text_on_maroon"/>
        <View android:layout_width="3dp" android:layout_height="28dp"
            android:layout_gravity="bottom|start"
            android:background="@color/text_on_maroon"/>
        <View android:layout_width="28dp" android:layout_height="3dp"
            android:layout_gravity="bottom|end"
            android:background="@color/text_on_maroon"/>
        <View android:layout_width="3dp" android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:background="@color/text_on_maroon"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Align notes here"
            android:fontFamily="@font/inter_regular"
            android:textSize="11sp"
            android:textColor="#88FFFFFF"
            android:background="#44000000"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </FrameLayout>

    <!-- Torch button -->
    <ImageButton
        android:id="@+id/btn_torch"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/btn_star_big_on"
        android:background="@drawable/bg_profile_chip"
        android:contentDescription="Toggle torch"
        android:padding="10dp"
        app:tint="@color/text_on_maroon"/>

    <!-- Bottom control panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#F03D1010"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_mic_ring_inner"
                android:gravity="center">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_scan"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LectureSnap"
                    android:fontFamily="@font/playfair_display_bold"
                    android:textSize="18sp"
                    android:textColor="@color/text_on_maroon"/>

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Point at lecture notes and tap Capture"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="12sp"
                    android:textColor="#CCF5F0EB"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:visibility="gone"
            android:indeterminateTint="@color/text_on_maroon"
            android:layout_marginBottom="12dp"/>

        <!-- Capture button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_capture"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Capture Notes"
            android:fontFamily="@font/inter_medium"
            android:textSize="15sp"
            android:textColor="@color/maroon_dark"
            app:backgroundTint="@color/text_on_maroon"
            app:cornerRadius="26dp"
            app:elevation="0dp"/>
    </LinearLayout>

</FrameLayout>