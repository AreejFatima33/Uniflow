<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="160dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/bg_wavy_header" android:scaleType="fitXY"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:paddingHorizontal="20dp" android:layout_marginBottom="34dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎓 Grade Predictor"
                        android:fontFamily="@font/playfair_display_bold"
                        android:textSize="22sp" android:textColor="@color/text_on_maroon"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Enter your marks to see what grade you can achieve"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="12sp" android:textColor="#CCF5F0EB"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Subject Name" style="@style/UniFlow.TextInput"
                android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSubject"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular" android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Quiz -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Quiz Marks" android:fontFamily="@font/inter_medium"
                android:textSize="14sp" android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Obtained"
                    style="@style/UniFlow.TextInput" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etQuizMarks" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:fontFamily="@font/inter_regular"
                        android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Total"
                    style="@style/UniFlow.TextInput">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etQuizTotal" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:fontFamily="@font/inter_regular"
                        android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Assignment -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Assignment Marks" android:fontFamily="@font/inter_medium"
                android:textSize="14sp" android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Obtained"
                    style="@style/UniFlow.TextInput" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAssignmentMarks" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:fontFamily="@font/inter_regular"
                        android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Total"
                    style="@style/UniFlow.TextInput">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAssignmentTotal" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:fontFamily="@font/inter_regular"
                        android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Midterm -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Midterm Marks" android:fontFamily="@font/inter_medium"
                android:textSize="14sp" android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="24dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Obtained"
                    style="@style/UniFlow.TextInput" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMidtermMarks" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:fontFamily="@font/inter_regular"
                        android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Total"
                    style="@style/UniFlow.TextInput">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMidtermTotal" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:fontFamily="@font/inter_regular"
                        android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="Calculate Grade" android:fontFamily="@font/inter_medium"
                android:textSize="16sp" style="@style/UniFlow.Button.Primary"
                android:layout_marginBottom="20dp"/>

            <ProgressBar android:id="@+id/progressBar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resultCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/cream_card"
                app:cardCornerRadius="16dp" app:cardElevation="2dp"
                app:strokeColor="@color/border_light" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:id="@+id/tvCurrentGrade"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair_display_bold"
                        android:textSize="20sp" android:textColor="@color/maroon_dark"
                        android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tvCurrentScore"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="15sp" android:textColor="@color/text_secondary"
                        android:layout_marginBottom="16dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border_light" android:layout_marginBottom="16dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Marks needed in Final Exam:"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="14sp" android:textColor="@color/text_primary"
                        android:layout_marginBottom="10dp"/>
                    <TextView android:id="@+id/tvRequiredForA"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp" android:textColor="@color/text_secondary"
                        android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tvRequiredForB"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp" android:textColor="@color/text_secondary"
                        android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tvRequiredForC"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>