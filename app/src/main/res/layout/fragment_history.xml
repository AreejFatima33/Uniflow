<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📂 History"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All your saved study data in one place."
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="24dp" />

        <!-- LectureSnap Notes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📖 Lecture Notes"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layout_notes_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_notes_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No notes saved yet."
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <!-- TimetableSnap -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Timetable Entries"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layout_timetable_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_timetable_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No timetable saved yet."
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <!-- ExamOracle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔮 Exam Topics"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layout_exam_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_exam_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No exam topics saved yet."
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <!-- DeadlineGenie -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ Study Plans"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layout_plans_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_plans_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No study plans saved yet."
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <!-- ConceptSnap -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Saved Concepts"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layout_concepts_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_concepts_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No concepts saved yet."
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>