<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Camera Preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/camera_preview_concept"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Status text -->
        <TextView
            android:id="@+id/tv_concept_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Point camera at a diagram or formula, then tap Capture."
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#444444" />

        <!-- Optional question -->
        <EditText
            android:id="@+id/et_concept_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Optional: Ask a specific question"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginHorizontal="16dp"
            android:background="@android:color/white"
            android:inputType="text"
            android:autofillHints="no" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progress_concept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Single capture button -->
        <Button
            android:id="@+id/btn_capture_concept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Capture &amp; Explain"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Torch button overlaid top-right — same as LectureSnap and TimetableSnap -->
    <ImageButton
        android:id="@+id/btn_torch_concept"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:src="@android:drawable/btn_star_big_on"
        android:background="@android:color/transparent"
        android:contentDescription="Toggle torch"
        app:tint="#888888" />

</FrameLayout>